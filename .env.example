# Copy to .env and fill in. Never commit .env.

# --- Vultr ---
# Account API key (Account > API): provisioning only, never used by the app
VULTR_API_KEY=
# Serverless Inference key (Console > Serverless > Inference > your subscription), NOT the account API key
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# --- Tiger Data (Postgres) ---
# Service connection string, e.g. postgres://tsdbadmin:<pw>@<host>:<port>/tsdb?sslmode=require
DATABASE_URL=
# Read-only role for the SQL console; migrate.py sets this role's password from here
READONLY_DATABASE_URL=postgres://bench_reader:<pick-a-password>@<host>:<port>/tsdb?sslmode=require

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
# Optional: voice for spoken replies (default Bella)
ELEVENLABS_VOICE_ID=

# --- Backboard.io ---
# Assistant that holds the analyst's long-term memory (POST /api/assistants once)
BACKBOARD_ASSISTANT_ID=
BACKBOARD_API_KEY=

# --- Deployment ---
APP_DOMAIN=
