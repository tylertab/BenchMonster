# Copy to .env and fill in. Never commit .env.

# --- Vultr ---
# Account API key (Account > API): provisioning only, never used by the app
VULTR_API_KEY=
# Serverless Inference key (Console > Serverless > Inference > your subscription), NOT the account API key
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# --- Tiger Data (Postgres) ---
# Service connection string, e.g. postgres://tsdbadmin:<pw>@<host>:<port>/tsdb?sslmode=require
DATABASE_URL=

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- Backboard.io ---
BACKBOARD_API_KEY=

# --- Deployment ---
APP_DOMAIN=
